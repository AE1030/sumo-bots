<!-- Sumo arena template. Placeholders are filled by sumo_sim/model.py. -->
<mujoco model="sumo_arena">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="$timestep" integrator="implicitfast" cone="elliptic"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.5 0.5 0.5"/>
  </visual>
  <default>
    <geom solref="0.004 1" solimp="0.95 0.99 0.001"/>
  </default>
  <worldbody>
    <!-- Physical floor: an infinite plane. The ring geoms below are visual only
         (contype=0) so they never affect contacts or the ToF rays (group 2). -->
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.35 0.35 0.38 1"
          friction="$floor_friction 0.005 0.0001" priority="0" group="0"/>
    <geom name="ring_border" type="cylinder" size="$ring_radius 0.0005" pos="0 0 0.0005"
          rgba="1 1 1 1" contype="0" conaffinity="0" group="2"/>
    <geom name="ring_black" type="cylinder" size="$inner_radius 0.0005" pos="0 0 0.0011"
          rgba="0.02 0.02 0.02 1" contype="0" conaffinity="0" group="2"/>
    <camera name="top" pos="0 0 2.3" xyaxes="1 0 0 0 1 0" fovy="40"/>
    <camera name="angled" pos="0 -1.9 1.5" xyaxes="1 0 0 0 0.62 0.78" fovy="45"/>
$robots
  </worldbody>
  <actuator>
$actuators
  </actuator>
  <sensor>
$sensors
  </sensor>
</mujoco>
